# Frontend runtime config.
# Local dev:
NEXT_PUBLIC_API_URL="http://localhost:4000"
# Production (Vercel): set this to your deployed Render API, e.g.
# NEXT_PUBLIC_API_URL="https://ggsports-api.onrender.com"
# NOTE: NEXT_PUBLIC_* variables are baked into the build on Vercel —
# set them in Vercel project settings BEFORE deploying. See DEPLOYMENT.md.
